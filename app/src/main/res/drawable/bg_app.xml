<?xml version="1.0" encoding="utf-8"?>
<!-- Root window background: deep space with a subtle blue/indigo glow in the lower half. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/ta_color_bg_space"
                android:centerColor="@color/ta_color_bg_primary"
                android:endColor="@color/ta_color_bg_secondary"
                android:type="linear"/>
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/ta_color_transparent"
                android:endColor="@color/ta_color_glow_blue"
                android:type="linear"/>
        </shape>
    </item>
</layer-list>
