<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ta_color_nav_background"/>
        </shape>
    </item>
    <item android:gravity="top" android:height="@dimen/ta_stroke_thin">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/ta_color_transparent"
                android:centerColor="@color/ta_color_primary_soft"
                android:endColor="@color/ta_color_transparent"
                android:type="linear"/>
        </shape>
    </item>
</layer-list>
