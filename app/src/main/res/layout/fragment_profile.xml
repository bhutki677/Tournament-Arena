<?xml version="1.0" encoding="utf-8"?>
<!-- Profile shell: identity card, stats, account/preferences/support rows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profile_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/ta_screen_padding_horizontal"
        android:paddingRight="@dimen/ta_screen_padding_horizontal"
        android:paddingTop="@dimen/ta_screen_padding_vertical"
        android:paddingBottom="@dimen/ta_screen_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/profile_header"
                layout="@layout/view_screen_header"/>

            <LinearLayout
                android:id="@+id/profile_identity_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ta_card_padding">

                <ImageView
                    android:id="@+id/profile_avatar"
                    style="@style/Widget.TA.Avatar"
                    android:layout_width="@dimen/ta_avatar_size_large"
                    android:layout_height="@dimen/ta_avatar_size_large"
                    android:contentDescription="@string/cd_avatar"
                    android:padding="@dimen/ta_space_lg"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/ta_color_primary"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ta_space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_name"
                        style="@style/TextAppearance.TA.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/profile_guest_name"/>

                    <TextView
                        android:id="@+id/profile_subtitle"
                        style="@style/TextAppearance.TA.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/profile_guest_sub"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_edit_button"
                    style="@style/Widget.TA.SmallButton"
                    android:text="@string/profile_edit_profile"/>
            </LinearLayout>

            <TextView
                style="@style/Widget.TA.SectionTitle"
                android:layout_marginTop="@dimen/ta_section_spacing"
                android:text="@string/section_my_stats"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ta_stat_tile_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_surface"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_stat_played_value"
                        style="@style/TextAppearance.TA.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_dash"/>

                    <TextView
                        style="@style/TextAppearance.TA.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_matches_played"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ta_stat_tile_height"
                    android:layout_marginStart="@dimen/ta_space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_surface"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_stat_won_value"
                        style="@style/TextAppearance.TA.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_dash"/>

                    <TextView
                        style="@style/TextAppearance.TA.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_matches_won"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ta_stat_tile_height"
                    android:layout_marginStart="@dimen/ta_space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_surface"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_stat_winrate_value"
                        style="@style/TextAppearance.TA.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_dash"/>

                    <TextView
                        style="@style/TextAppearance.TA.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_win_rate"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Widget.TA.SectionTitle"
                android:layout_marginTop="@dimen/ta_section_spacing"
                android:text="@string/section_account"/>

            <include android:id="@+id/profile_row_edit_profile" layout="@layout/view_menu_row"/>
            <include android:id="@+id/profile_row_notifications" layout="@layout/view_menu_row"/>

            <TextView
                style="@style/Widget.TA.SectionTitle"
                android:layout_marginTop="@dimen/ta_section_spacing"
                android:text="@string/section_preferences"/>

            <include android:id="@+id/profile_row_settings" layout="@layout/view_menu_row"/>

            <TextView
                style="@style/Widget.TA.SectionTitle"
                android:layout_marginTop="@dimen/ta_section_spacing"
                android:text="@string/section_support"/>

            <include android:id="@+id/profile_row_help" layout="@layout/view_menu_row"/>
            <include android:id="@+id/profile_row_terms" layout="@layout/view_menu_row"/>
            <include android:id="@+id/profile_row_privacy" layout="@layout/view_menu_row"/>
            <include android:id="@+id/profile_row_logout" layout="@layout/view_menu_row"/>

            <TextView
                android:id="@+id/profile_version"
                style="@style/TextAppearance.TA.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ta_space_xl"
                android:gravity="center"
                android:text="@string/app_name"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/profile_loading"
        layout="@layout/view_loading"
        android:visibility="gone"/>

    <include
        android:id="@+id/profile_empty"
        layout="@layout/view_empty_state"
        android:visibility="gone"/>

    <include
        android:id="@+id/profile_error"
        layout="@layout/view_error_state"
        android:visibility="gone"/>
</FrameLayout>
