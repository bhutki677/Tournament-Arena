<?xml version="1.0" encoding="utf-8"?>
<!-- Wallet shell: balance card, wallet actions, transaction list. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wallet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/wallet_swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/wallet_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingLeft="@dimen/ta_screen_padding_horizontal"
            android:paddingRight="@dimen/ta_screen_padding_horizontal"
            android:paddingTop="@dimen/ta_screen_padding_vertical"
            android:paddingBottom="@dimen/ta_screen_padding_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/wallet_header"
                    layout="@layout/view_screen_header"/>

                <LinearLayout
                    android:id="@+id/wallet_balance_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_wallet_card"
                    android:orientation="vertical"
                    android:padding="@dimen/ta_card_padding">

                    <TextView
                        style="@style/TextAppearance.TA.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_current_balance"/>

                    <TextView
                        android:id="@+id/wallet_balance_value"
                        style="@style/TextAppearance.TA.Headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ta_space_xs"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/label_dash"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ta_space_lg"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.TA.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/label_locked_balance"/>

                            <TextView
                                android:id="@+id/wallet_locked_value"
                                style="@style/TextAppearance.TA.BodyStrong"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/label_dash"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.TA.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/label_total_winnings"/>

                            <TextView
                                android:id="@+id/wallet_winnings_value"
                                style="@style/TextAppearance.TA.BodyStrong"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/label_dash"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ta_space_lg"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wallet_deposit_button"
                        style="@style/Widget.TA.PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/action_deposit"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wallet_withdraw_button"
                        style="@style/Widget.TA.SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="@dimen/ta_space_md"
                        android:layout_weight="1"
                        android:text="@string/action_withdraw"/>
                </LinearLayout>

                <TextView
                    style="@style/Widget.TA.SectionTitle"
                    android:layout_marginTop="@dimen/ta_section_spacing"
                    android:text="@string/section_recent_transactions"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/wallet_transactions_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"/>

                <TextView
                    style="@style/TextAppearance.TA.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ta_space_xl"
                    android:text="@string/label_mock_notice"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include
        android:id="@+id/wallet_loading"
        layout="@layout/view_loading"
        android:visibility="gone"/>

    <include
        android:id="@+id/wallet_empty"
        layout="@layout/view_empty_state"
        android:visibility="gone"/>

    <include
        android:id="@+id/wallet_error"
        layout="@layout/view_error_state"
        android:visibility="gone"/>
</FrameLayout>
