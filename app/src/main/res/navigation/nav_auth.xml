<?xml version="1.0" encoding="utf-8"?>
<!-- Authentication flow graph. Destination ids are referenced by AuthActivity and the fragments. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_auth"
    app:startDestination="@id/nav_login">

    <fragment
        android:id="@+id/nav_login"
        android:name="com.vk.tournamentapp.fragments.auth.LoginFragment"
        android:label="@string/title_login"
        tools:layout="@layout/fragment_login"
        xmlns:tools="http://schemas.android.com/tools">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/nav_register"
            app:enterAnim="@anim/fragment_enter"
            app:exitAnim="@anim/fragment_exit"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit"/>
        <action
            android:id="@+id/action_login_to_forgot_password"
            app:destination="@id/nav_forgot_password"
            app:enterAnim="@anim/fragment_enter"
            app:exitAnim="@anim/fragment_exit"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit"/>
        <action
            android:id="@+id/action_login_to_otp"
            app:destination="@id/nav_otp"
            app:enterAnim="@anim/fragment_enter"
            app:exitAnim="@anim/fragment_exit"
            app:popEnterAnim="@anim/fragment_pop_enter"
            app:popExitAnim="@anim/fragment_pop_exit"/>
    </fragment>

    <fragment
        android:id="@+id/nav_register"
        android:name="com.vk.tournamentapp.fragments.auth.RegisterFragment"
        android:label="@string/title_register"
        tools:layout="@layout/fragment_register"
        xmlns:tools="http://schemas.android.com/tools">
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/nav_login"
            app:popUpTo="@id/nav_login"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fragment_enter"
            app:exitAnim="@anim/fragment_exit"/>
        <action
            android:id="@+id/action_register_to_otp"
            app:destination="@id/nav_otp"
            app:enterAnim="@anim/fragment_enter"
            app:exitAnim="@anim/fragment_exit"/>
    </fragment>

    <fragment
        android:id="@+id/nav_forgot_password"
        android:name="com.vk.tournamentapp.fragments.auth.ForgotPasswordFragment"
        android:label="@string/title_forgot_password"
        tools:layout="@layout/fragment_forgot_password"
        xmlns:tools="http://schemas.android.com/tools">
        <action
            android:id="@+id/action_forgot_to_otp"
            app:destination="@id/nav_otp"
            app:enterAnim="@anim/fragment_enter"
            app:exitAnim="@anim/fragment_exit"/>
        <action
            android:id="@+id/action_forgot_to_login"
            app:destination="@id/nav_login"
            app:popUpTo="@id/nav_login"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/nav_otp"
        android:name="com.vk.tournamentapp.fragments.auth.OtpFragment"
        android:label="@string/title_otp"
        tools:layout="@layout/fragment_otp"
        xmlns:tools="http://schemas.android.com/tools"/>
</navigation>
